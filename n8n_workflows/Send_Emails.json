    {
      "parameters": {
        "jsCode": "// n8n Code Node — single response field\n\nconst item = items?.[0]?.json ?? {};\n\n// Safely extract email ID\nconst id = typeof item.id === \"string\" ? item.id : null;\n\n// Safely extract labels\nconst labelIds = Array.isArray(item.labelIds) ? item.labelIds : [];\n\n// Determine send status\nconst sent = labelIds.includes(\"SENT\");\n\n// Combine status and emailId into a single field\nreturn [\n  {\n    json: {\n      response: {\n        status: sent ? \"success\" : \"failed\",\n        emailId: id\n      }\n    }\n  }\n];\n"
      },
